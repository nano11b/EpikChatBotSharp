# Copy this file to .env and fill in your values.
# NEVER commit your real tokens/API keys.
BOT_TOKEN=your-epikchat-bot-token
# Used only to migrate scores from the old single-room format.
ROOM_ID=your-epikchat-room-id
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
BFSTATS_API_URL=https://bfstats.nano11bravo.com
BFSTATS_TIMEOUT_MS=10000
BFSTATS_CACHE_TTL_MS=30000
BFSTATS_COOLDOWN_MS=3000
BFSTATS_WATCH_INTERVAL_MS=900000
BOT_NAME=PHD Meowington
SERVER_URL=https://ws.epikchat.com

# Chat reliability and limits (milliseconds where applicable)
COMMAND_COOLDOWN_MS=3000
TRIVIA_GUESS_COOLDOWN_MS=500
MARBLES_COOLDOWN_MS=1000
SOCKET_ACK_TIMEOUT_MS=10000
PERSIST_DEBOUNCE_MS=100
MESSAGE_MAX_LENGTH=250
AI_MAX_REPLY_LENGTH=2000
AI_CONTINUATION_TTL_MS=600000
USER_HISTORY_LIMIT=10
MAX_TRACKED_USERS=500
IGNORED_SENDER_IDS=6a3e570003a479abf0327353
IGNORED_USERNAMES=nicknamepending

# Trivia
TRIVIA_QUESTION_TIME_MS=30000
TRIVIA_ATTEMPTS_PER_USER=3
# cumulative retains scores between games; session clears them on each start
TRIVIA_SCORE_MODE=cumulative
TRIVIA_ADMIN_CONTROLS=true
TRIVIA_FILE=./trivia.json
TRIVIA_SCORE_FILE=./trivia-scores.json
MEMORY_FILE=./memory.json
DATABASE_FILE=./bot-state.sqlite
SETTINGS_FILE=./room-settings.json
LOYALTY_FILE=./loyalty.json
SCHEDULES_FILE=./schedules.json
TRIVIA_STATS_FILE=./trivia-stats.json
ROLES_FILE=./roles.json
AUDIT_FILE=./audit.jsonl
OUTBOX_FILE=./outbox.json
SUBMISSIONS_FILE=./question-submissions.json
USER_PREFERENCES_FILE=./user-preferences.json
MARBLES_SEASONS_FILE=./marbles-seasons.json

# Reliability, recovery, extensions, and privacy
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_RETRY_BASE_MS=5000
OUTBOX_RETRY_MAX_MS=300000
BACKUP_DIRECTORY=./backups
# Recommended. When set, backups use AES-256-GCM encryption.
BACKUP_ENCRYPTION_KEY=
PLUGINS_DIRECTORY=./plugins
RETENTION_DAYS=90
OPERATIONS_ALERTS_ENABLED=true
OPERATIONS_CHECK_INTERVAL_MS=300000

# Moderation
MODERATION_BLOCKED_WORDS=
MODERATION_FLOOD_LIMIT=6
MODERATION_FLOOD_WINDOW_MS=10000
MODERATION_REPEAT_LIMIT=3

# Structured logging
LOG_FILE=./bot.log.jsonl
LOG_MAX_BYTES=5000000
LOG_CONSOLE=true

# Loopback-only web dashboard and health endpoint. Generate a token of at least 32 bytes.
# Use an HTTPS reverse proxy if remote dashboard access is required.
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
DASHBOARD_TOKEN=
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-a-long-random-password
DASHBOARD_SESSION_TTL_MS=43200000
DASHBOARD_TLS_KEY_FILE=
DASHBOARD_TLS_CERT_FILE=

# Marbles on Stream custom-name bridge
MARBLES_ENABLED=true
MARBLES_FILE=./marbles.csv
MARBLES_REGISTRATION_OPEN=true
MARBLES_CONFIRM_JOINS=true
MARBLES_JOIN_COMMANDS=!play,!marbles

# Configure at least one admin identity to use .marbles open/close/reset/count.
# Comma-separated values are supported. Usernames are case-insensitive.
MARBLES_ADMIN_USERNAMES=your_epikchat_username
MARBLES_ADMIN_IDS=
