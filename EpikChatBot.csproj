<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EpikChatBot</RootNamespace>
    <AssemblyName>EpikChatBot</AssemblyName>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.20" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- MessagePack 3.1.2 targets the Socket.IO 3.1.1 serializer ABI. Keep the client pinned to match. -->
    <PackageReference Include="SocketIOClient" Version="3.1.1" />
    <PackageReference Include="SocketIO.Serializer.MessagePack" Version="3.1.2" />
    <!-- Override vulnerable transitive lower bounds while retaining the compatible Socket.IO ABI. -->
    <PackageReference Include="MessagePack" Version="3.1.8" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests-csharp/**/*.cs" />
    <Content Remove="tests-csharp/**" />
    <Content Remove="legacy-node/**" />
    <None Remove="tests-csharp/**" />
    <None Remove="legacy-node/**" />
    <None Update="trivia.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="marbles.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update=".env.example" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
